# Google ToDo リストの取り込みに使う OAuth クライアントID。
#
# 秘密の値ではありません（ブラウザに出ます）。クライアントシークレットは
# この作りでは使いません。設定しなければ、連携の入口が出ないだけです。
#
# 取り方は docs/google-tasks.md を見てください。
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 日報の連携先（Apps Script をウェブアプリとして公開したときの URL）。
#
# 例: https://script.google.com/macros/s/xxxxxxxx/exec
# 設定しなければ、日報の画面が「未設定」と出るだけです。
DAILY_REPORT_GAS_URL=

# 日報の連携で使う合言葉。Apps Script のスクリプト プロパティ
# 「API_SHARED_SECRET」と同じ値を設定してください。
#
# 秘密の値です。NEXT_PUBLIC_ を付けないでください（ブラウザに出てしまいます）。
DAILY_REPORT_SECRET=
